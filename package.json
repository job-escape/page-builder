{
  "name": "@job-escape/page-builder",
  "version": "0.3.0-beta.0",
  "description": "Generic page-builder engine: Effector-backed state, MDX → React parser, logic-action executor, navigation & dialogs. Extracted from the Job Escape funnel.",
  "license": "UNLICENSED",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.js"
    },
    "./runtime-client": {
      "types": "./dist/runtime-client.d.ts",
      "import": "./dist/runtime-client.mjs",
      "require": "./dist/runtime-client.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/job-escape/page-builder.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project=storybook"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-cookie": "^3.0.8",
    "json-rules-engine": "^7.3.1",
    "lucide-react": "^0.525.0",
    "react-slick": "^0.31.0",
    "slick-carousel": "^1.8.1",
    "tailwind-merge": "^2.6.1",
    "uuid": "^10.0.0"
  },
  "peerDependencies": {
    "@effector/next": "^0.7.2",
    "@emotion/react": "^11.14.0",
    "@farfetched/core": "^0.15.0",
    "@grafana/faro-web-sdk": "^2.8.2",
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "effector": "^23.4.2",
    "effector-react": "^23.3.0",
    "framer-motion": "^11.9.0 || ^12.0.0",
    "html-react-parser": "^5.1.10",
    "next": "^14.2.35 || ^15.0.0 || ^16.0.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "swiper": "^11.1.3",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@effector/next": "^0.7.2",
    "@emotion/react": "^11.14.0",
    "@farfetched/core": "^0.15.0",
    "@grafana/faro-web-sdk": "^2.8.2",
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.12.11",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^10.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "framer-motion": "^11.18.2",
    "html-react-parser": "^5.2.17",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next": "^14.2.35",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-aria-components": "^1.19.0",
    "react-dom": "^18.3.1",
    "storybook": "^10.5.5",
    "swiper": "^11.2.10",
    "ts-jest": "^29.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.0",
    "vaul": "^1.1.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
