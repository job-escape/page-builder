{
  "name": "@job-escape/page-builder",
  "version": "0.2.44",
  "description": "Generic page-builder engine: Effector-backed state, MDX → React parser, logic-action executor, navigation & dialogs. Extracted from the Job Escape funnel.",
  "license": "UNLICENSED",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/job-escape/page-builder.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "json-rules-engine": "^7.3.1",
    "lucide-react": "^0.525.0",
    "tailwind-merge": "^2.6.1",
    "uuid": "^10.0.0"
  },
  "peerDependencies": {
    "@effector/next": "^0.7.2",
    "@emotion/react": "^11.14.0",
    "@farfetched/core": "^0.15.0",
    "@heroui/react": "^3.0.0",
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "effector": "^23.4.2",
    "effector-react": "^23.3.0",
    "framer-motion": "^11.9.0 || ^12.0.0",
    "html-react-parser": "^5.1.10",
    "next": "^14.2.35 || ^15.0.0 || ^16.0.0",
    "next-axiom": "^1.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swiper": "^11.1.3",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@effector/next": "^0.7.2",
    "@emotion/react": "^11.14.0",
    "@farfetched/core": "^0.15.0",
    "@heroui/react": "^3.1.0",
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "framer-motion": "^11.18.2",
    "html-react-parser": "^5.2.17",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next": "^15.0.0",
    "next-axiom": "^1.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swiper": "^11.2.10",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.0"
  }
}
